config SHIELD_TOTEM_CUSTOM_LEFT
    def_bool $(shields_list_contains,totem_custom_left)
    select ZMK_SPLIT
    select SHIELD_TOTEM_CUSTOM

config SHIELD_TOTEM_CUSTOM_RIGHT
    def_bool $(shields_list_contains,totem_custom_right)
    select ZMK_SPLIT
    select SHIELD_TOTEM_CUSTOM

config SHIELD_TOTEM_CUSTOM_DONGLE
    def_bool $(shields_list_contains,totem_custom_dongle)
    select ZMK_SPLIT_ROLE_CENTRAL
    select ZMK_SPLIT
    select SHIELD_TOTEM_CUSTOM