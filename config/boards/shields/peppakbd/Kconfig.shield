config SHIELD_PEPPAKBD_LEFT
    def_bool $(shields_list_contains,peppakbd_left)
    select ZMK_SPLIT
    select SHIELD_PEPPAKBD

config SHIELD_PEPPAKBD_RIGHT
    def_bool $(shields_list_contains,peppakbd_right)
    select ZMK_SPLIT
    select SHIELD_PEPPAKBD

config SHIELD_PEPPAKBD_DONGLE
    def_bool $(shields_list_contains,peppakbd_dongle)
    select ZMK_SPLIT_ROLE_CENTRAL
    select ZMK_SPLIT
    select SHIELD_PEPPAKBD